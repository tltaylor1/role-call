# Copy to .env (git ignores it) and set a real value for each key.
# The compose file refuses to start while a key is missing.

# Local database password. Generate one, for example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Only needed when running the application outside docker compose:
# ROLECALL_DATABASE_URL=postgresql+psycopg://rolecall:the-password@localhost:5432/rolecall
